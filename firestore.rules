rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid}.role が admin かどうか（管理画面用）
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{uid}.role が teacher かどうか（スケジュール枠の登録用）
    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{uid} {
      // 作成は本人のみ、かつ role は student 固定。
      // 以前は teacher も許していたため、リクエストを直接投げれば誰でも講師になれた。
      // 講師は応募（submitTeacherApplication）→ 運営の審査を経て、
      // Firebase コンソール / Admin SDK（ルールをバイパス）で role を teacher に変更する。
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      // 更新は本人のみ。ただし role の変更は禁止（admin への自己昇格を防ぐ）。
      // admin 付与は Firebase コンソール / Admin SDK（ルールをバイパス）でのみ行う。
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /reservations/{reservationId} {
      // 予約の作成は Cloud Functions（Admin SDK, ルールをバイパス）経由のみ。
      // クライアントからの直接作成は禁止（不正な userId・金額のねじ込みを防ぐ）。
      allow create: if false;
      // 生徒本人・担当講師・admin が閲覧可能
      allow read: if (isSignedIn()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.teacherId))
        || isAdmin();
      // 更新もクライアントからは禁止。以前は生徒本人に全フィールドの更新を許していたため、
      // 生徒が自分の予約の reservationStatus / paymentStatus / lessonAmount を
      // 書き換えられる状態だった（未決済のまま「確定」にする等）。
      // キャンセルは cancelReservation、日程変更は rescheduleReservation、
      // オンラインの参加URLは setMeetingUrl、決済状態は stripeWebhook が
      // それぞれ Admin SDK（ルールをバイパス）で更新するため、ここは閉じてよい。
      allow update: if false;
      allow delete: if false;
    }

    // 予約1件ごとの手数料明細（料率・運営手数料・講師取り分）。
    // 予約本体は生徒本人も読めるため、生徒に見せない情報はこちらに分離している。
    // 読めるのは担当講師本人と admin のみ。書き込みは Cloud Functions（Admin SDK）だけ。
    match /reservationPayouts/{reservationId} {
      allow read: if (isSignedIn() && request.auth.uid == resource.data.teacherId)
        || isAdmin();
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // 作成は Cloud Functions（submitReview, Admin SDK でルールをバイパス）経由のみ。
      // クライアントから直接書けると、レビュー投稿キャンペーンの付与条件
      // （支払い済み・受講済み・本人・1回まで）を検証できず、
      // キャンペーン対象を示す campaign フィールドも自由に詐称できてしまう。
      allow create: if false;
      // 更新できるのは次の2通りだけ。変更できるフィールドも限定する。
      //  - 投稿者本人: 本文と評価のみ（投稿者・対象講師の付け替えや、
      //    講師になりすまして reply を書くことを防ぐ）
      //  - 担当講師: reply のみ（teacherAuthUid が自分の uid のレビューに限る）
      // teacherAuthUid を持たない古いレビューには講師は返信できない。
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['comment', 'rating']))
        ||
        (request.auth.uid == resource.data.get('teacherAuthUid', '')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reply']))
      );
      // 削除は投稿者本人または admin（不適切レビュー対応）
      allow delete: if (isSignedIn()
        && request.auth.uid == resource.data.userId)
        || isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      // 枠の登録・編集は role が teacher のアカウントで、かつ自分の枠のみ。
      // 以前はログインしていれば誰でも（生徒アカウントでも）枠を作れた。
      allow create: if isTeacher()
        && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if isTeacher()
        && request.auth.uid == resource.data.teacherId;
    }

    // お問い合わせ。作成は Cloud Functions（Admin SDK）経由のみ
    match /contacts/{contactId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // 講師応募。作成は Cloud Functions（Admin SDK）経由のみ
    match /teacherApplications/{applicationId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // 演奏・展示などの依頼。作成は Cloud Functions（Admin SDK）経由のみ
    match /requests/{requestId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // スタジオマスタ。空き検索のため read は公開、更新は admin のみ
    match /studios/{studioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // スタジオの予約ロック。空き照会のため read は公開、
    // 書き込みは Cloud Functions（Admin SDK）経由のみ（二重予約防止）
    match /studioBookings/{bookingId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // クーポン。本人が予約フォームで一覧・選択するため read は本人と admin。
    // 発行・状態遷移（available/reserved/used/expired/cancelled）はすべて
    // Cloud Functions（Admin SDK）が行う。クライアントから書ければ
    // 値引き額も使用済み判定も詐称できてしまう。
    match /coupons/{couponId} {
      allow read: if (isSignedIn() && request.auth.uid == resource.data.userId)
        || isAdmin();
      allow create, update, delete: if false;
    }

    // 付与済みかどうかの台帳（ドキュメントIDが決め打ち）。
    // 存在自体が「付与済み」を意味するため、本人にも見せずサーバー専用にする。
    match /couponGrants/{grantKey} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 友達紹介の紐づけ。紹介者は自分が紹介した相手の進捗を見る必要があるため、
    // 紹介者・被紹介者の双方が read できる（金額や個人情報は入れない）。
    match /referrals/{refereeUid} {
      allow read: if (isSignedIn()
        && (request.auth.uid == resource.data.refereeUid
            || request.auth.uid == resource.data.referrerUid))
        || isAdmin();
      allow create, update, delete: if false;
    }

    // 運営の手動操作（クーポンの発行・無効化、紹介の無効化）の監査ログ。
    // 誰がいつ何をなぜ行ったかの記録なので、書き込みは Cloud Functions のみ。
    match /campaignAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 紹介コード → uid の逆引き。総当たりで他人を特定されないよう read は admin のみ。
    // 照合は Cloud Functions（checkReferralCode / applyReferralCode）が行う。
    match /referralCodes/{code} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 講師プロフィールとコース。
    //
    // 公開中（published == true）のものは未ログインの訪問者にも見せる。
    // 未公開（下書き・申請中）は運営と本人だけが読める。書き込みは今は運営のみで、
    // 講師本人による編集は別途フォームを用意してから開放する。
    match /teacherProfiles/{teacherId} {
      allow read: if resource.data.published == true
        || isAdmin()
        || (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // 講師の招待トークン。
    //
    // read を許すと、トークンを引ければ誰でも講師になれてしまう。
    // 有効性の確認は checkTeacherInvite（Cloud Functions）が行う。
    match /teacherInvites/{token} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 検索ログ。集計を見るのは運営だけなので read は admin のみ。
    // 書き込みは logSearch（Cloud Functions）に限る。クライアントから直接
    // 書けると、件数を水増しして需要があるように見せかけられてしまう。
    match /searchLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
